<Window x:Class="PensionBase.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}"
        FocusManager.FocusedElement="{Binding ElementName=FullNameBox}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Новый пользователь" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />

        <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FullNameBox" MaxLength="150" />

        <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LoginBox" MaxLength="50" />

        <TextBlock Text="Пароль (не короче 6 символов)" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput" />

        <TextBlock Text="Повтор пароля" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmInput" />

        <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <Button x:Name="CreateButton" Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" IsDefault="True"
                Margin="0,18,0,0" Click="Create_Click" />
        <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,8,0,0" />
    </StackPanel>
</Window>
