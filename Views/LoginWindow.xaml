<Window x:Class="PensionBase.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Учёт пенсионеров" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="Учебная информационная система" Foreground="#5B6773" Margin="0,2,0,8" />

        <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LoginBox" />

        <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput" />

        <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <Button x:Name="SignInButton" Content="Войти" Style="{StaticResource PrimaryButton}" IsDefault="True"
                Margin="0,18,0,0" Click="SignIn_Click" />
        <Button x:Name="OpenRegisterButton" Content="Регистрация" Margin="0,8,0,0" Click="Register_Click" />
    </StackPanel>
</Window>
